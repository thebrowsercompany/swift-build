{
  "name": "Android",
  "canonical_name": "android",

  "archs": [
    { "arch": "arm64", "triple": "aarch64-unknown-linux-android{{ANDROID_API_LEVEL}}", "ds2_program_prefix": "aarch64-unknown-linux-android-" },
    { "arch": "armv7", "triple": "armv7-unknown-linux-androideabi{{ANDROID_API_LEVEL}}", "ds2_program_prefix": "armv7-unknown-linux-android-" },
    { "arch": "i686", "triple": "i686-unknown-linux-android{{ANDROID_API_LEVEL}}", "ds2_program_prefix": "i686-unknown-linux-android-" },
    { "arch": "x86_64", "triple": "x86_64-unknown-linux-android{{ANDROID_API_LEVEL}}", "ds2_program_prefix": "x86_64-unknown-linux-android-" }
  ],
  "variants": ["static", "shared"],

  "setup": {
    "vs_dev_env": false,
    "ndk_version": "{{ANDROID_NDK_VERSION}}"
  },
  "configure": {
    "android_api_level": "{{ANDROID_API_LEVEL}}",
    "android_clang_version": "{{ANDROID_CLANG_VERSION}}"
  },
  "compilers": {
    "c": "Stage1.GNUC",
    "cxx": "Stage1.GNUCXX"
  },
  "libraries": {
    "zlib": "libz.a",
    "brotlicommon": "libbrotlicommon.a",
    "brotlidec": "libbrotlidec.a"
  },
  "curl": {
    "CURL_USE_SCHANNEL": "NO",
    "CURL_WINDOWS_SSPI": "NO",
    "USE_WIN32_IDN": "NO",
    "USE_WIN32_LARGE_FILES": "NO"
  },

  "ds2": true,
  "runtime_module": false,
  "foundation_build_tools": false,
  "testing_include_sdk_headers": true,
  "publish_symbols": false,

  "sdk_settings": {
    "llvm_target_vendor": "unknown",
    "llvm_target_sys": "linux",
    "llvm_target_environment": "android{{ANDROID_API_LEVEL}}",
    "default_properties": {}
  }
}

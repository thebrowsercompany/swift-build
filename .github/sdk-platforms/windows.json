{
  "name": "Windows",
  "canonical_name": "windows",

  "archs": [
    { "arch": "amd64", "triple": "x86_64-unknown-windows-msvc", "backtrace": true, "upload_host_cdispatch": true },
    { "arch": "arm64", "triple": "aarch64-unknown-windows-msvc", "backtrace": true, "upload_host_cdispatch": true },
    { "arch": "x86", "triple": "i686-unknown-windows-msvc", "backtrace": false, "upload_host_cdispatch": false }
  ],
  "variants": ["static", "shared"],

  "setup": {
    "vs_dev_env": true,
    "ndk_version": ""
  },
  "configure": {
    "android_api_level": "",
    "android_clang_version": ""
  },
  "compilers": {
    "c": "Stage1.C",
    "cxx": "Stage1.CXX"
  },
  "libraries": {
    "zlib": "libzs.lib",
    "brotlicommon": "brotlicommon.lib",
    "brotlidec": "brotlidec.lib"
  },
  "curl": {
    "CURL_USE_SCHANNEL": "YES",
    "CURL_WINDOWS_SSPI": "YES",
    "USE_WIN32_IDN": "YES",
    "USE_WIN32_LARGE_FILES": "YES"
  },

  "ds2": false,
  "runtime_module": true,
  "foundation_build_tools": true,
  "testing_include_sdk_headers": false,
  "publish_symbols": true,

  "sdk_settings": {
    "llvm_target_vendor": "unknown",
    "llvm_target_sys": "windows",
    "llvm_target_environment": "msvc",
    "default_properties": { "DEFAULT_USE_RUNTIME": "MD" }
  }
}
